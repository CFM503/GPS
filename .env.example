# ==============================================================================
# 道路路产智能巡查与 GIS 管理系统 - 环境变量配置模板
# ==============================================================================

# 服务端口与运行模式
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# 数据库连接 (PostgreSQL 15 + PostGIS)
# 格式: postgres://username:password@host:port/database
DATABASE_URL=postgres://gis_user:gis_secret_password@localhost:5432/road_gis_db

# 地图引擎服务提供商配置 (AMAP | BAIDU | TIANDITU)
MAP_PROVIDER=AMAP
AMAP_KEY=your_amap_web_api_key_here
AMAP_SECURITY_CODE=your_amap_security_code_here
BAIDU_KEY=your_baidu_map_api_key_here

# 对象存储服务 (MinIO / AWS S3 兼容协议)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=road-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# JWT 鉴权与安全密钥
JWT_SECRET=super_secret_jwt_token_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# 视频切片与存储配置
VIDEO_MAX_CHUNK_SIZE_MB=50
UPLOAD_TEMP_DIR=./uploads/temp
UPLOAD_STORAGE_DIR=./uploads/storage
