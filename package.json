{
  "name": "road-asset-system",
  "version": "1.2.0",
  "description": "道路路产智能巡查与 GIS 管理系统 (Road Asset Intelligent Patrol & GIS Management System)",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:all": "node scripts/dev-all.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "gis",
    "road-asset",
    "patrol",
    "postgis",
    "gps",
    "video-sync"
  ],
  "author": "Road Asset Management Team",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
